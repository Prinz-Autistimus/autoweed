# Diese Werte in Portainer unter "Environment variables" des jeweiligen Stacks eintragen.
# Zufallswerte erzeugen: openssl rand -hex 32

# --- Beide Stacks ---------------------------------------------------------
# Muss auf Pi und ECS identisch sein.
BOARD_TOKEN=
# Image-Tag: latest (nur Releases) oder edge (jeder Push auf main)
AUTOWEED_TAG=latest
# Prüfintervall von Watchtower in Sekunden
WATCHTOWER_INTERVAL=300

# --- Nur host-compose.yml (ECS) -------------------------------------------
# Adresse des Pi im LAN
BOARD_URL=http://<pi-ip>:8080
# Mindestens 8 Zeichen, die WebUI ist öffentlich erreichbar
WEBUI_PASSWORD=
# Zufälliger Name, ntfy läuft ohne Anmeldung (z. B. autoweed-<openssl rand -hex 8>)
NTFY_TOPIC=
# Standard: bestehendes ntfy auf ECS über dessen Host-Port
NTFY_URL=http://host.docker.internal:8090
INFLUX_PASSWORD=
INFLUX_TOKEN=
# Host-Port der WebUI (Ziel für den Nginx Proxy Manager)
AUTOWEED_PORT=8097
# Öffentliche Adresse, wird in ntfy-Nachrichten verlinkt
PUBLIC_URL=https://autoweed.example.org
# Wie oft ECS das Board abfragt (Sekunden)
POLL_INTERVAL_SECS=10

# --- Nur pi-compose.yml (Board) ------------------------------------------
# sht31 oder sht40
CLIMATE_SENSOR=sht40
# BCM-Nummern der Ausgänge
HEATER_PIN=17
LIGHT_PIN=27
PUMP_PIN=22
# Relais-Module mit Optokoppler schalten bei LOW
RELAY_ACTIVE_LOW=true
